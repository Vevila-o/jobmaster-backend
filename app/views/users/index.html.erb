

  <% content_for(:title) { t(".title") } %>
      <%= link_to t("navigation.new_user_path"), new_user_path(@user), data: {turbo: false},class: "btn btn-primary" %>
      
      <div class="overflow-x-auto mt-4">
        <table class="table table-lg">
          <thead>
            <tr class="bg-base-200 text-base-content">
              <th><%= User.human_attribute_name(:id) %></th>
              <th><%= User.human_attribute_name(:name) %></th>
              <th><%= User.human_attribute_name(:email) %></th>
              <th><%= User.human_attribute_name(:role) %></th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <%= render partial: "user", collection: @users, locals: { actions: true } %>
          </tbody>
        </table>
      </div>

