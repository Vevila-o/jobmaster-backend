
  <tr>
    <td> <%= user.id %> </td>
    <td> <%= user.name %> </td>
    <td> <%= user.email %> </td>
    <td> <%= user.role %> </td>
    <% if local_assigns[:actions] %>
      <td>
        <%= link_to t("action.edit"), edit_user_path(user) %>
        <%= link_to t("action.delete"), user_path(user), data: { turbo_method: :delete, turbo_confirm: t("action.delete_confirm") } %>
      </td>
    <% end %>
  </tr>
