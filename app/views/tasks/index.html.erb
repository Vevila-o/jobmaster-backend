    <% content_for(:title) { t("task.index.title") } %>
      <table>
        <thead>
          <tr>
            <td><%=Task.human_attribute_name(:id) %></td>
            <td><%=Task.human_attribute_name(:title) %></td>
            <td><%=Task.human_attribute_name(:content)%> </td>
          </tr>
        </thead>
        <tbody>

          <% @tasks.each do |task| %>
          
          <tr>
            <td> <%=task.id%></td>
            <td> <%=task.title %> </td>
            <td> <%=task.content %> </td>
            <td>
              <%= link_to t("action.edit"), edit_task_path(task) %>
              <%= link_to t("action.delete"), task_path(task), data: { turbo_method: :delete, turbo_confirm: t("action.delete_confirm")} %>
            </td>
          </tr>
          <% end %> 
        </tbody>
      </table>
      <br>

    <%= link_to t("path.new_task_path"), new_task_path %>
    <%= link_to t("path.users_path"), "/users" %>
