
    <div>

      <turbo-frame id="<%=dom_id(task)%>" class="flex gap-4">

        <div> <%=task.id%></div>
        <div> <%=task.title %> </div>
        <div> <%=task.content %> </div>
        <div>
          <%= link_to t("action.edit"), edit_task_path(task) %>
          <%= link_to t("action.delete"), task_path(task), data: { turbo_method: :delete, turbo_frame: "_top", turbo_confirm: t("action.delete_confirm")} %>
        </div>
      </turbo-frame>
    </div>
