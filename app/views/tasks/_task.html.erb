
<turbo-frame id="<%= dom_id(task) %>" class="block border-b border-base-200 hover:bg-base-200/40">
  <table class="table table-fixed w-full">
    <tbody>
      <tr>
        <td class="w-12"><%= task.id %></td>
        <td class="w-32 font-medium truncate task-title"><%= task.title %></td>
        <td class="truncate"><%= task.content %></td>
        <td class="w-44"><%= l(task.end_time, format: :long) %></td>
        <td class="w-16"><%= t(task.status, scope: %i[activerecord attributes task statuses]) %></td>
        <td class="w-16"><%= t(task.priority, scope: %i[activerecord attributes task priorities]) %></td>
        <td class="w-16"><%= task.user.name %></td>
        <td class="w-40">
          <%= link_to t("action.edit"), edit_task_path(task), class: "btn btn-ghost btn-sm text-base font-normal" %>
          <%= link_to t("action.delete"), task_path(task), class: "btn btn-ghost btn-sm text-base font-normal text-error", data: { turbo_method: :delete, turbo_frame: "_top", turbo_confirm: t("action.delete_confirm") } %>
        </td>
      </tr>
    </tbody>
  </table>
</turbo-frame>
