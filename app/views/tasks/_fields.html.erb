 <% if @task.errors.any? %>
      <div class="error-msg">
        <% @task.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>
    <br>
    
    <br>

      <%= f.label :title, Task.human_attribute_name(:title) %>
      <%= f.text_field :title %> <br />

      <%= f.label :content, Task.human_attribute_name(:content) %>
      <%= f.text_field :content %> <br />

      <%= f.label :end_time, Task.human_attribute_name(:end_time)%>
      <%= f.datetime_field :end_time %> <br />

      <%= f.label :status, Task.human_attribute_name(:status)%>
      <%= f.select :status, Task.statuses.keys.map { |x| [t(x, scope: %i[activerecord attributes task statuses]), x] } %> <br />

      <%= f.submit %>

