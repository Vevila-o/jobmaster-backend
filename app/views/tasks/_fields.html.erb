<% if @task.errors.any? %>
  <div class="alert alert-error mb-4">
    <ul class="list-disc list-inside">
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="max-w-xl space-y-3">
  <div>
    <%= f.label :title, Task.human_attribute_name(:title), class: "label" %>
    <%= f.text_field :title, class: "input w-full" %>
  </div>

  <div>
    <%= f.label :content, Task.human_attribute_name(:content), class: "label" %>
    <%= f.text_field :content, class: "input w-full" %>
  </div>

  <div>
    <%= f.label :end_time, Task.human_attribute_name(:end_time), class: "label" %>
    <%= f.datetime_field :end_time, class: "input w-full" %>
  </div>

  <div class="flex flex-wrap gap-3">
    <div>
      <%= f.label :status, Task.human_attribute_name(:status), class: "label" %>
      <%= f.select :status, Task.statuses.keys.map { |x| [ t(x, scope: %i[activerecord attributes task statuses]), x ] }, {}, { class: "select" } %>
    </div>

    <div>
      <%= f.label :priority, Task.human_attribute_name(:priority), class: "label" %>
      <%= f.select :priority, Task.priorities.keys.map { |x| [ t(x, scope: %i[activerecord attributes task priorities]), x ] }, {}, { class: "select" } %>
    </div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
</div>

