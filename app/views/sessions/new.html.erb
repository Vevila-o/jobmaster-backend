<% content_for(:title) { t(".title") } %>

<%= form_with url: session_path do |f| %>
  <div class="max-w-md space-y-3">
    <div>
      <%= f.label :email, User.human_attribute_name(:email), class: "label" %>
      <%= f.email_field :email, class: "input w-full", autofocus: true, autocomplete: "email" %>
    </div>

    <div>
      <%= f.label :password, User.human_attribute_name(:password), class: "label" %>
      <%= f.password_field :password, class: "input w-full", autocomplete: "current-password" %>
    </div>

    <%= f.submit t(".submit"), class: "btn btn-primary" %>
  </div>
<% end %>
