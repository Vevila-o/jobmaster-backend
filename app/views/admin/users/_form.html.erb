
<%= form_with model: [ :admin, @user ] do |f| %>
  <% if @user.errors.any? %>
    <div class="alert alert-error mb-4">
      <ul class="list-disc list-inside">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="max-w-md space-y-3">
    <div>
      <%= f.label :name, User.human_attribute_name(:name), class: "label" %>
      <%= f.text_field :name, class: "input w-full" %>
    </div>

    <div>
      <%= f.label :email, User.human_attribute_name(:email), class: "label" %>
      <%= f.text_field :email, class: "input w-full" %>
    </div>

    <div>
      <%= f.label :password, User.human_attribute_name(:password), class: "label" %>
      <%= f.password_field :password, class: "input w-full" %>
    </div>

    <div>
      <%= f.label :role, User.human_attribute_name(:role), class: "label" %>
      <%= f.select :role, User.roles.keys.map { |x| [ t(x, scope: %i[activerecord attributes user roles]), x ] }, {}, class: "select w-full" %>
    </div>

    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>